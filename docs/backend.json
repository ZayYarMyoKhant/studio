
{
  "entities": {
    "CalculationHistory": {
      "title": "Calculation History",
      "description": "Historical record of construction material calculations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "inputType": { "type": "string", "enum": ["area", "volume"] },
        "inputValue": { "type": "number" },
        "results": {
          "type": "object",
          "properties": {
            "bricks": { "type": "number" },
            "cementLbs": { "type": "number" },
            "cementBags": { "type": "number" },
            "sandCuft": { "type": "number" },
            "sandKyin": { "type": "number" }
          }
        },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "inputType", "inputValue", "results", "createdAt"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}/history/{historyId}": {
      "schema": "CalculationHistory",
      "description": "User's calculation history for quick reference."
    }
  }
}
