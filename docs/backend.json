
{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "A student in a class.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rollNumber": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "rollNumber"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance record for a student on a specific day.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "day": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri"] },
        "weekStartDate": { "type": "string" },
        "present": { "type": "boolean" }
      },
      "required": ["id", "studentId", "day", "weekStartDate", "present"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}/students/{studentId}": {
      "schema": "Student",
      "description": "List of students managed by the teacher."
    },
    "/users/{userId}/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Daily attendance records."
    }
  }
}
